generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String?  // Nom Prénom
  role           String?  // Etudiant / Enseignant / Autre
  currentSchool  String?  // École actuelle
  behanceLink    String?
  instaLink      String?
  personalLink   String?
  profilePicture String?
  projects       Project[] // Relation: Un utilisateur peut avoir plusieurs projets
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String   // Titre
  description String?  // Description
  type        String   // "Portfolio" ou "Mémoire"
  school      String   // Ecole
  year        Int      // Année
  domain      String   // Domaine (ex: Design, Architecture...)
  pdfUrl      String   // Lien vers le PDF uploadé
  pdfSize     String?  // Poids du PDF en Mo (ex: "1.2 Mo")
  coverUrl    String?  // Lien vers la couverture (optionnel)
  
  // Relation avec l'utilisateur (Auteur)
  userId      String
  author      User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
